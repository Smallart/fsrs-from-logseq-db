{
  "name": "fsrs-from-logseq-db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run migrate && next dev -p 3000",
    "build": "next build",
    "start": "npm run migrate && next start -p 8790",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=.env src/server/migrations/migrations.ts",
    "migrate:up": "tsx --env-file=.env src/server/migrations/migrations.ts up",
    "migrate:down": "tsx --env-file=.env src/server/migrations/migrations.ts down"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.27.5",
    "lucide-react": "^1.68.0",
    "next": "^14.2.18",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-fsrs": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

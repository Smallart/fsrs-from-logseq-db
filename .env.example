# PostgreSQL
POSTGRES_USER=fsrs
POSTGRES_PASSWORD=fsrs_secret
POSTGRES_DB=fsrs
DATABASE_URL=postgresql://fsrs:fsrs_secret@localhost:5432/fsrs

# Application
APP_PASSWORD=change_me          # 登录密码
SESSION_SECRET=change_me        # session cookie 签名密钥（openssl rand -base64 32）

# Logseq
# （不再需要）——卡片数据经 logseq-cli2http 网关读写，网关 URL 在应用
